# A&J Real Estate Group — environment variables
# Copy to .env.local and fill in real values (never commit .env.local).

# Supabase — ITMANO CRM project (public read of published listings).
# Anon key only; the web never uses the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact form -> ITMANO CRM contact webhook (server-to-server)
# Channel public_id for the "Contact Us" form.
NEXT_PUBLIC_ITMANO_CONTACT_PUBLIC_ID=chn_qv8uhxg9qizl
# Shared secret for the x-contact-secret header. NEVER commit the real value —
# set it in .env.local and in the Vercel project env vars.
CONTACT_WEBHOOK_SECRET=

# Client check-in / lead status-update form (/check-in) -> its own ITMANO
# channel, same "contact" webhook type + the CONTACT_WEBHOOK_SECRET above.
ITMANO_CHECKIN_CHANNEL_ID=chn_x5yxx15jt7wf

# Newsletter (/newsletter) -> ITMANO newsletter channel. This one is the PUBLIC
# intake endpoint and takes no secret: it is guarded by the non-guessable
# channel id + a honeypot + schema validation. The browser posts to
# /api/intake/<id>/submit, which next.config.ts rewrites to the CRM so the call
# stays first-party (no CORS, no tracker blockers).
NEXT_PUBLIC_ITMANO_NEWSLETTER_CHANNEL_ID=chn_aoad7icta5o2
